# Copy to .env.local for local dev. When deploying, set these in Vercel's
# dashboard (Project Settings -> Environment Variables) instead.
#
# Safe to expose to the client (Vite only bundles VITE_-prefixed vars):
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional -- leave blank to run without error tracking.
VITE_SENTRY_DSN=

# Server-only. NEVER prefix with VITE_ -- that would ship it to the
# client bundle. Only used by scripts/tests run from your machine, never
# read by the deployed app itself.
SUPABASE_SERVICE_ROLE_KEY=
